<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="350.0" prefHeight="300.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uv.lis.sistema_administracion_transacciones.controlador.LoginController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="EuroBank">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>
        <Label text="Sistema de Administración" textFill="#666666" />
        <VBox spacing="5.0">
            <children>
                <Label text="Usuario:" />
                <TextField fx:id="txtUsuario" promptText="Ingrese su usuario" />
            </children>
        </VBox>
        <VBox spacing="5.0">
            <children>
                <Label text="Contraseña:" />
                <PasswordField fx:id="txtContrasenia" promptText="Ingrese su contraseña" />
            </children>
        </VBox>
        <Button fx:id="btnIngresar" maxWidth="Infinity" text="Ingresar" onAction="#controlarIngresar" style="-fx-background-color: #0056b3; -fx-text-fill: white;">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox>